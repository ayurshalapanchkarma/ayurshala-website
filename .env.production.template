# ============================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================================
# DO NOT COMMIT THIS FILE IF IT CONTAINS REAL SECRETS
# Copy to .env.production and fill in with actual values
# ============================================================

# Application
NODE_ENV=production
# Production domain - MUST be https://ayurshalapanchakarma.com
# Never use app., dev., or staging. prefixes
NEXT_PUBLIC_SITE_URL=https://ayurshalapanchakarma.com

# ============================================================
# SUPABASE (Production Database & Auth)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# SECURITY KEYS (MUST be at least 32 characters each)
# Generate with: openssl rand -hex 32
# ============================================================
JWT_SECRET=your-jwt-secret-here-minimum-32-characters
CSRF_TOKEN_SECRET=your-csrf-token-secret-here-minimum-32-characters
SESSION_ENCRYPTION_KEY=your-session-encryption-key-here-minimum-32-characters

# ============================================================
# LLM PROVIDERS (Optional - Choose one)
# ============================================================
# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# Google
# GOOGLE_API_KEY=...

# Azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=...

# ============================================================
# EMAIL SERVICE (SMTP)
# ============================================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=noreply@ayurshalapanchakarma.com

# ============================================================
# WHATSAPP INTEGRATION
# ============================================================
WHATSAPP_API_KEY=your-whatsapp-api-key
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# ============================================================
# SMS INTEGRATION
# ============================================================
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=AYURSHALA

# ============================================================
# PAYMENT GATEWAY (Razorpay)
# ============================================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ============================================================
# ANALYTICS & MONITORING (Optional)
# ============================================================
# Sentry for error tracking
# SENTRY_DSN=https://...

# DataDog for APM
# DATADOG_API_KEY=...

# Google Analytics
# GOOGLE_ANALYTICS_ID=G-...

# ============================================================
# FEATURE FLAGS (Optional)
# ============================================================
FEATURE_AI_ENABLED=true
FEATURE_WEBHOOKS_ENABLED=true
FEATURE_MAINTENANCE_MODE=false
